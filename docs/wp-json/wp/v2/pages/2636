dth: 1024px) 100vw, 1024px\" src=\"data:image\/svg+xml;base64,PHN2ZyB3aWR0aD0iMSIgaGVpZ2h0PSIxIiB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciPjwvc3ZnPg==\" \/><\/figure>\n\n\n\n<p class=\"wp-block-paragraph\"><\/p>\n<\/div><\/div><\/div>\n\n\n\n<div class=\"wp-block-stackable-column stk-block-column stk-column stk-block stk-940f9b4\" data-v=\"4\" data-block-id=\"940f9b4\"><style>@media screen and (min-width: 768px){.stk-940f9b4 {flex:var(--stk-flex-grow, 1) 1 calc(60% - var(--stk-column-gap, 0px) * 1 \/ 2 ) !important;}}<\/style><div class=\"stk-column-wrapper stk-block-column__content stk-container stk-940f9b4-container stk--no-background stk--no-padding\"><div class=\"stk-block-content stk-inner-blocks stk-940f9b4-inner-blocks\">\n<h2 class=\"wp-block-heading\"><span style=\"color: var(--wp--preset--color--teal); font-size: 2rem; text-align: var(--stk-alignment-text-align,start); background-color: var(--bs-body-bg); font-family: var(--bs-body-font-family);\">Linda Lloyd Jones<\/span><span style=\"color: #008c73;\" class=\"stk-highlight\"> MBE FRSA  <\/span> <\/h2>\n\n\n\n<p class=\"wp-block-paragraph\"><span style=\"color: #78b338;\" class=\"stk-highlight\"><strong>CCAC Honorary Officer<\/strong><\/span><\/p>\n\n\n\n<div class=\"wp-block-stackable-text stk-block-text stk-block stk-fa4a0d7\" data-block-id=\"fa4a0d7\"><p class=\"stk-block-text__text\">When Climate Change All Change was conceived, Linda was very pleased to become the charity\u2019s Honorary Officer, assisting with governance and administration. Having had the good fortune to be in the company of artists and designers throughout her career Linda has seen first-hand the impact of ethical and beneficial design on our environment. As today\u2019s children will inherit a world very different to the one her generation knew, it is imperative to equip them to take on the climate challenge in a positive and agentive way. CCAC is pioneering this approach.<\/p><\/div>\n<\/div><\/div><\/div>\n<\/div><\/div>\n\n\n\n<div class=\"wp-block-stackable-divider stk-block-divider stk-block stk-66730e7 is-style-bar\" data-block-id=\"66730e7\"><style>.stk-66730e7 hr.stk-block-divider__hr{background:#008c73 !important;border-radius:calc(1px \/ 2) !important;height:1px !important;width:100% !important;}.stk-66730e7 {margin-top:30px !important;margin-bottom:50px !important;}<\/style><hr class=\"stk-block-divider__hr\"\/><\/div>\n\n\n\n<div class=\"wp-block-stackable-columns stk-block-columns stk-block stk-5eaa345\" data-block-id=\"5eaa345\"><div class=\"stk-row stk-inner-blocks stk-block-content stk-content-align stk-5eaa345-column\">\n<div class=\"wp-block-stackable-column stk-block-column stk-column stk-block stk-c0aad15\" data-v=\"4\" data-block-id=\"c0aad15\"><style>@media screen and (min-width: 768px){.stk-c0aad15 {flex:var(--stk-flex-grow, 1) 1 calc(40% - var(--stk-column-gap, 0px) * 1 \/ 2 ) !important;}}<\/style><div class=\"stk-column-wrapper stk-block-column__content stk-container stk-c0aad15-container stk--no-background stk--no-padding\"><div class=\"stk-block-content stk-inner-blocks stk-c0aad15-inner-blocks\">\n<figure class=\"wp-block-image size-full is-resized is-style-rounded\"><img decoding=\"async\" width=\"656\" height=\"669\" data-src=\"https:\/\/cc-ac.org\/wp-content\/uploads\/2023\/07\/David_Lloyd_Jones_Portrait.webp\" alt=\"\" class=\"wp-image-3517 lazyload\" style=\"--smush-placeholder-width: 656px; --smush-placeholder-aspect-ratio: 656\/669;width:295px;height:301px\" data-srcset=\"https:\/\/cc-ac.org\/wp-content\/uploads\/2023\/07\/David_Lloyd_Jones_Portrait.webp 656w, https:\/\/cc-ac.org\/wp-content\/uploads\/2023\/07\/David_Lloyd_Jones_Portrait-294x300.webp 294w, https:\/\/cc-ac.org\/wp-content\/uploads\/2023\/07\/David_Lloyd_Jones_Portrait-196x200.webp 196w, https:\/\/cc-ac.org\/wp-content\/uploads\/2023\/07\/David_Lloyd_Jones_Portrait-123x125.webp 123w\" data-sizes=\"(max-width: 656px) 100vw, 656px\" src=\"data:image\/svg+xml;base64,PHN2ZyB3aWR0aD0iMSIgaGVpZ2h0PSIxIiB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciPjwvc3ZnPg==\" \/><\/figure>\n<\/div><\/div><\/div>\n\n\n\n<div class=\"wp-block-stackable-column stk-block-column stk-column stk-block stk-4c643de\" data-v=\"4\" data-block-id=\"4c643de\"><style>@media screen and (min-width: 768px){.stk-4c643de {flex:var(--stk-flex-grow, 1) 1 calc(60% - var(--stk-column-gap, 0px) * 1 \/ 2 ) !important;}}<\/style><div class=\"stk-column-wrapper stk-block-column__content stk-container stk-4c643de-container stk--no-background stk--no-padding\"><div class=\"stk-block-content stk-inner-blocks stk-4c643de-inner-blocks\">\n<h2 class=\"wp-block-heading\"><span style=\"color: var(--wp--preset--color--teal); font-size: 2rem; text-align: var(--stk-alignment-text-align,start); background-color: var(--bs-body-bg); font-family: var(--bs-body-font-family);\">David Lloyd Jones<\/span><strong> <\/strong><span style=\"color: #008c73;\" class=\"stk-highlight\">AADip RIBA FRSA<\/span>   <\/h2>\n\n\n\n<div class=\"wp-block-stackable-text stk-block-text stk-block stk-5ff47e7\" data-block-id=\"5ff47e7\"><p class=\"stk-block-text__text\"><span style=\"color: #78b338;\" class=\"stk-highlight\"><strong>CCAC Chair and Trustee<\/strong><\/span><\/p><\/div>\n\n\n\n<div class=\"wp-block-stackable-text stk-block-text stk-block stk-b7701a5\" data-block-id=\"b7701a5\"><p class=\"stk-block-text__text\">David is an architect and environmentalist. Global research and findings in the late 1970s alerted him to the negative impact of conventional building design and construction on our environment and climate. David has spent much of his professional career designing green demonstration projects, presenting papers, participating in international research programmes, writing books, proselytising for greater care of our planet, and advocating for a reassessment of priorities and imaginative design. Frustrated by the slow progress towards a regenerative future he looked to those that will be most affected, school children, and to find a way to help them channel their concern for the future through design initiatives into positive proactive activity. DaeWha and David got together and set up Climate Change All Change.<\/p><\/div>\n<\/div><\/div><\/div>\n<\/div><\/div>\n\n\n\n<div class=\"wp-block-stackable-divider stk-block-divider stk-block stk-0fcd525 is-style-bar\" data-block-id=\"0fcd525\"><style>.stk-0fcd525 hr.stk-block-divider__hr{background:#008c73 !important;border-radius:calc(1px \/ 2) !important;height:1px !important;width:100% !important;}.stk-0fcd525 {margin-top:30px !important;margin-bottom:50px !important;}<\/style><hr class=\"stk-block-divider__hr\"\/><\/div>\n\n\n\n<div class=\"wp-block-stackable-columns stk-block-columns stk-block stk-29d4f14\" data-block-id=\"29d4f14\"><div class=\"stk-row stk-inner-blocks stk-block-content stk-content-align stk-29d4f14-column\">\n<div class=\"wp-block-stackable-column stk-block-column stk-column stk-block stk-72040ee\" data-v=\"4\" data-block-id=\"72040ee\"><style>@media screen and (min-width: 768px){.stk-72040ee {flex:var(--stk-flex-grow, 1) 1 calc(40% - var(--stk-column-gap, 0px) * 1 \/ 2 ) !important;}}<\/style><div class=\"stk-column-wrapper stk-block-column__content stk-container stk-72040ee-container stk--no-background stk--no-padding\"><div class=\"stk-block-content stk-inner-blocks stk-72040ee-inner-blocks\">\n<figure class=\"wp-block-image size-large is-resized is-style-rounded\"><img decoding=\"async\" width=\"1024\" height=\"1024\" data-src=\"https:\/\/cc-ac.org\/wp-content\/uploads\/2023\/07\/IMG-20211009-WA0000-1-1024x1024.jpg\" alt=\"\" class=\"wp-image-3727 lazyload\" style=\"--smush-placeholder-width: 1024px; --smush-placeholder-aspect-ratio: 1024\/1024;width:291px;height:291px\" data-srcset=\"https:\/\/cc-ac.org\/wp-content\/uploads\/2023\/07\/IMG-20211009-WA0000-1-1024x1024.jpg 1024w, https:\/\/cc-ac.org\/wp-content\/uploads\/2023\/07\/IMG-20211009-WA0000-1-300x300.jpg 300w, https:\/\/cc-ac.org\/wp-content\/up