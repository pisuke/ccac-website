<summary class="wp-block-stackable-column stk-block-column stk-column stk-block stk-3a777b3 stk--container-small stk-block-accordion__heading" data-v="4" data-block-id="3a777b3"><div class="stk-column-wrapper stk-block-column__content stk-container stk-3a777b3-container stk-hover-parent"><div class="stk-block-content stk-inner-blocks stk-3a777b3-inner-blocks">
<div class="wp-block-stackable-icon-label stk-block-icon-label stk-block stk-0bf122f" data-block-id="0bf122f"><div class="stk-row stk-inner-blocks stk-block-content">
<div class="wp-block-stackable-heading stk-block-heading stk-block-heading--v2 stk-block stk-939c8ec" id="helen-charman-frsa-director-of-learning-and-national-programmes-young-v-amp-a" data-block-id="939c8ec"><h4 class="stk-block-heading__text has-text-color">Helen Charman FRSA, Director of Learning and National Programmes, Young V&amp;A</h4></div>



<div class="wp-block-stackable-icon stk-block-icon stk-block stk-a8bf183" data-block-id="a8bf183"><span class="stk--svg-wrapper"><div class="stk--inner-svg"><svg style="height:0;width:0"><defs><linearGradient id="linear-gradient-a8bf183" x1="0" x2="100%" y1="0" y2="0"><stop offset="0%" style="stop-opacity:1;stop-color:var(--linear-gradient-a-8-bf-183-color-1)"></stop><stop offset="100%" style="stop-opacity:1;stop-color:var(--linear-gradient-a-8-bf-183-color-2)"></stop></linearGradient></defs></svg><svg data-prefix="fas" data-icon="chevron-down" class="svg-inline--fa fa-chevron-down fa-w-14" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512" aria-hidden="true" width="32" height="32"><path fill="currentColor" d="M207.029 381.476L12.686 187.132c-9.373-9.373-9.373-24.569 0-33.941l22.667-22.667c9.357-9.357 24.522-9.375 33.901-.04L224 284.505l154.745-154.021c9.379-9.335 24.544-9.317 33.901.04l22.667 22.667c9.373 9.373 9.373 24.569 0 33.941L240.971 381.476c-9.373 9.372-24.569 9.372-33.942 0z"></path></svg></div></span></div>
