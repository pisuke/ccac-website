74-container stk--no-background stk--no-padding\"><div class=\"stk-block-content stk-inner-blocks stk-7ce0774-inner-blocks\">\n<div class=\"wp-block-stackable-columns stk-block-columns stk-block stk-8061ecc\" data-block-id=\"8061ecc\"><style>.stk-8061ecc {padding-right:30px !important;padding-bottom:0px !important;padding-left:30px !important;margin-top:10px !important;margin-bottom:50px !important;}@media screen and (max-width: 1023px){.stk-8061ecc {padding-right:0px !important;padding-left:0px !important;}}<\/style><div class=\"stk-row stk-inner-blocks stk-block-content stk-content-align stk-8061ecc-column\">\n<div class=\"wp-block-stackable-column stk-block-column stk-column stk-block stk-839b10e stk-block-background\" data-v=\"4\" data-block-id=\"839b10e\"><style>.stk-839b10e {background-color:#e8f0db !important;padding-top:50px !important;}.stk-839b10e:before{background-color:#e8f0db !important;}<\/style><div class=\"stk-column-wrapper stk-block-column__content stk-container stk-839b10e-container stk--no-background stk--no-padding\"><div class=\"stk-block-content stk-inner-blocks stk-839b10e-inner-blocks\">\n<p class=\"has-text-align-center has-large-font-size wp-block-paragraph\">Climate Change All Change is run by a small group of passionate designers, educators and administrators who are committed to developing creative, practical responses to the climate crisis.&nbsp; They are supported by expert consultants and volunteers.<\/p>\n<\/div><\/div><\/div>\n<\/div><\/div>\n<\/div><\/div><\/div>\n<\/div><\/div>\n\n\n\n<div class=\"wp-block-stackable-columns stk-block-columns stk-block stk-05ce88d\" data-block-id=\"05ce88d\"><div class=\"stk-row stk-inner-blocks stk-block-content stk-content-align stk-05ce88d-column\">\n<div class=\"wp-block-stackable-column stk-block-column stk-column stk-block stk-e1e0a3d\" data-v=\"4\" data-block-id=\"e1e0a3d\"><style>@media screen and (min-width: 768px){.stk-e1e0a3d {flex:var(--stk-flex-grow, 1) 1 calc(40% - var(--stk-column-gap, 0px) * 1 \/ 2 ) !important;}}<\/style><div class=\"stk-column-wrapper stk-block-column__content stk-container stk-e1e0a3d-container stk--no-background stk--no-padding\"><div class=\"stk-block-content stk-inner-blocks stk-e1e0a3d-inner-blocks\">\n<figure class=\"wp-block-image size-full is-style-rounded\"><img decoding=\"async\" width=\"300\" height=\"300\" data-src=\"https:\/\/cc-ac.org\/wp-content\/uploads\/2023\/07\/kimberley-crop.jpg\" alt=\"\" class=\"wp-image-3399 lazyload\" data-srcset=\"https:\/\/cc-ac.org\/wp-content\/uploads\/2023\/07\/kimberley-crop.jpg 300w, https:\/\/cc-ac.org\/wp-content\/uploads\/2023\/07\/kimberley-crop-150x150.jpg 150w, https:\/\/cc-ac.org\/wp-content\/uploads\/2023\/07\/kimberley-crop-200x200.jpg 200w, https:\/\/cc-ac.org\/wp-content\/uploads\/2023\/07\/kimberley-crop-125x125.jpg 125w\" data-sizes=\"(max-width: 300px) 100vw, 300px\" src=\"data:image\/svg+xml;base64,PHN2ZyB3aWR0aD0iMSIgaGVpZ2h0PSIxIiB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciPjwvc3ZnPg==\" style=\"--smush-placeholder-width: 300px; --smush-placeholder-aspect-ratio: 300\/300;\" \/><\/figure>\n<\/div><\/div><\/div>\n\n\n\n<div class=\"wp-block-stackable-column stk-block-column stk-column stk-block stk-8e4b124\" data-v=\"4\" data-block-id=\"8e4b124\"><style>@media screen and (min-width: 768px){.stk-8e4b124 {flex:var(--stk-flex-grow, 1) 1 calc(60% - var(--stk-column-gap, 0px) * 1 \/ 2 ) !important;}}<\/style><div class=\"stk-column-wrapper stk-block-column__content stk-container stk-8e4b124-container stk--no-background stk--no-padding\"><div class=\"stk-block-content stk-inner-blocks stk-8e4b124-inner-blocks\">\n<h2 class=\"wp-block-heading has-teal-color has-text-color\">Kimberly Safford<\/h2>\n\n\n\n<p class=\"has-green-color has-text-color wp-block-paragraph\"><strong>CCAC Secretary and Trustee<\/strong><\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Kimberly is an Honorary Associate of The Open University, formerly Senior Lecturer in Education Studies. She is interested in \u2018climate literacy\u2019: the basic facts about atmospheric science, greenhouse gases and the carbon cycle, that everyone should understand. Kimberly supports CCAC designers to plan and reflect on their activities in schools, how to make their knowledge and skills accessible to children, and how to work collaboratively with teachers. She joined Climate Change All Change because the climate crisis is the biggest threat to children\u2019s wellbeing. Working with a creative designer, children can imagine and create a sustainable future.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\"><\/p>\n<\/div><\/div><\/div>\n<\/div><\/div>\n\n\n\n<div class=\"wp-block-stackable-divider stk-block-divider stk-block stk-0f5cafa is-style-bar\" data-block-id=\"0f5cafa\"><style>.stk-0f5cafa hr.stk-block-divider__hr{background:#008c73 !important;border-radius:calc(1px \/ 2) !important;height:1px !important;width:100% !important;}.stk-0f5cafa {margin-top:30px !important;margin-bottom:30px !important;}<\/style><hr class=\"stk-block-divider__hr\"\/><\/div>\n\n\n\n<div class=\"wp-block-stackable-columns stk-block-columns stk-block stk-98d2c36\" data-block-id=\"98d2c36\"><div class=\"stk-row stk-inner-blocks stk-block-content stk-content-align stk-98d2c36-column\">\n<div class=\"wp-block-stackable-column stk-block-column stk-column stk-block stk-df728fd\" data-v=\"4\" data-block-id=\"df728fd\"><style>@media screen and (min-width: 768px){.stk-df728fd {flex:var(--stk-flex-grow, 1) 1 calc(40% - var(--stk-column-gap, 0px) * 1 \/ 2 ) !important;}}<\/style><div class=\"stk-column-wrapper stk-block-column__content stk-container stk-df728fd-container stk--no-background stk--no-padding\"><div class=\"stk-block-content stk-inner-blocks stk-df728fd-inner-blocks\">\n<figure class=\"wp-block-image size-medium is-style-rounded\"><img decoding=\"async\" width=\"300\" height=\"300\" data-src=\"https:\/\/cc-ac.org\/wp-content\/uploads\/2023\/07\/DaeWhaKang-300x300.jpg\" alt=\"\" class=\"wp-image-3402 lazyload\" data-srcset=\"https:\/\/cc-ac.org\/wp-content\/uploads\/2023\/07\/DaeWhaKang-300x300.jpg 300w, https:\/\/cc-ac.org\/wp-content\/uploads\/2023\/07\/DaeWhaKang-150x150.jpg 150w, https:\/\/cc-ac.org\/wp-content\/uploads\/2023\/07\/DaeWhaKang-200x200.jpg 200w, https:\/\/cc-ac.org\/wp-content\/uploads\/2023\/07\/DaeWhaKang-125x125.jpg 125w, https:\/\/cc-ac.org\/wp-content\/uploads\/2023\/07\/DaeWhaKang.jpg 768w\" data-sizes=\"(max-width: 300px) 100vw, 300px\" src=\"data:image\/svg+xml;base64,PHN2ZyB3aWR0aD0iMSIgaGVpZ2h0PSIxIiB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciPjwvc3ZnPg==\" style=\"--smush-placeholder-width: 300px; --smush-placeholder-aspect-ratio: 300\/300;\" \/><\/figure>\n<\/div><\/div><\/div>\n\n\n\n<div class=\"wp-block-stackable-column stk-block-column stk-column stk-block stk-99561bd\" data-v=\"4\" data-block-id=\"99561bd\"><style>@media screen and (min-width: 768px){.stk-99561bd {flex:var(--stk-flex-grow, 1) 1 calc(60% - var(--stk-column-gap, 0px) * 1 \/ 2 ) !important;}}<\/style><div class=\"stk-column-wrapper stk-block-column__content stk-container stk-99561bd-container stk--no-background stk--no-padding\"><div class=\"stk-block-content stk-inner-blocks stk-99561bd-inner-blocks\">\n<h2 class=\"wp-block-heading has-teal-color has-text-color\">DaeWha Kang BA MArch ARB RIBA<\/h2>\n\n\n\n<p class=\"has-green-color has-text-color wp-block-paragraph\"><strong>CCAC Trustee and Treasurer<\/strong><\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Artist and designer&nbsp;DaeWha Kang&nbsp;founded his architectural practice in 2014 with the goal of improving wellbeing through beautiful and innovative design. Growing up in the Pacific Northwest, DaeWha Kang has always felt a very strong connection with nature and the environment. His work focuses strongly on sustainability and designing with long-term thinking in mind. In 2019, David and DaeWha Kang set up&nbsp;CCAC with the aim of moving hearts,&nbsp;not only minds. DaeWha Kang&nbsp;made the commitment to CCAC to&nbsp;ensure his son can have a bright and flourishing future in a hospitable world.&nbsp;<\/p>\n<\/div><\/div><\/div>\n<\/div><\/div>\n\n\n\n<div class=\"wp-block-stackable-divider stk-block-divider stk-block stk-40eccee is-style-bar\" data-block-id=\"40eccee\"><style>.stk-40eccee hr.stk-block-divider__hr{background:#008c73 !important;border-radius:calc(1px \/ 2) !important;height:1px !important;width:100% !important;}.stk-40eccee {margin-top:30px !important;margin-bottom:30px !important;}<\/style><hr class=\"stk-block-divider__hr\"\/><\/div>\n\n\n\n<div class=\"wp-block-stackable-columns stk-block-columns stk-block stk-6ec9a70\" data-block-id=\"6ec9a70\"><div class=\"stk-row stk-inner-blocks stk-block-content stk-content-align stk-6ec9a70-column\">\n<div class=\"wp-block-stackable-column stk-block-column stk-column stk-block stk-1d68977\" data-v=\"4\" data-block-id=\"1d68977\"><style>@media screen and (min-width: 768px){.stk-1d68977 {flex:var(--stk-flex-grow, 1) 1 calc(40% - var(--stk-column-gap, 0px) * 1 \/ 2 ) !important;}}<\/style><div class=\"stk-column-wrapper stk-block-column__content stk-container stk-1d68977-container stk--no-background stk--no-padding\"><div class=\"stk-block-content stk-inner-blocks stk-1d68977-inner-blocks\">\n<figure class=\"wp-block-image size-full is-resized is-style-rounded\"><img decoding=\"async\" width=\"400\" height=\"400\" data-src=\"https:\/\/cc-ac.org\/wp-content\/uploads\/2023\/07\/nicole-newman-linkedin6-1.jpg\" alt=\"\" class=\"wp-image-3418 lazyload\" style=\"--smush-placeholder-width: 400px; --smush-placeholder-aspect-ratio: 400\/400;width:305px;height:305px\" data-srcset=\"https:\/\/cc-ac.org\/wp-content\/uploads\/2023\/07\/nicole-newman-linkedin6-1.jpg 400w, https:\/\/cc-ac.org\/wp-content\/uploads\/2023\/07\/nicole-newman-linkedin6-1-300x300.jpg 300w, https:\/\/cc-ac.org\/wp-content\/uploads\/2023\/07\/nicole-newman-linkedin6-1-150x150.jpg 150w, https:\/\/cc-ac.org\/wp-content\/uploads\/2023\/07\/nicole-newman-linkedin6-1-200x200.jpg 200w, https:\/\/cc-ac.org\/wp-content\/uploads\/2023\/07\/nicole-newman-linkedin6-1-125x125.jpg 125w\" data-sizes=\"(max-width: 400px) 100vw, 400px\" src=\"data:image\/svg+xml;base64,PHN2ZyB3aWR0aD0iMSIgaGVpZ2h0PSIxIiB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciPjwvc3ZnPg==\" \/><\/figure>\n\n\n\n<p class=\"wp-block-paragraph\"><\/p>\n<\/div><\/div><\/div>\n\n\n\n<div class=\"wp-block-stackable-column stk-block-column stk-column stk-block stk-e1f3904\" data-v=\"4\" data-block-id=\"e1f3904\"><style>@media screen and (min-width: 768px){.stk-e1f3904 {flex:var(--stk-flex-grow, 1) 1 calc(60% - var(--stk-column-gap, 0px) * 1 \/ 2 ) !important;}}<\/style><div class=\"stk-column-wrapper stk-block-column__content stk-container stk-e1f3904-container stk--no-background stk--no-padding\"><div class=\"stk-block-content stk-inner-blocks stk-e1f3904-inner-blocks\">\n<h2 class=\"wp-block-heading\"><span style=\"color: var(--wp--preset--color--teal); font-size: 2rem; text-align: var(--stk-alignment-text-align,start); background-color: var(--bs-body-bg); font-family: var(--bs-body-font-family);\">Nicole Newman<\/span>   <\/h2>\n\n\n\n<p class=\"wp-block-paragraph\"><strong><span style=\"color: #78b338;\" class=\"stk-highlight\">CCAC Trustee<\/span><\/strong><\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Nicole is a fundraising and sponsorship consultant who provides strategic advice and support on income generation to arts and education charities in the UK and internationally.&nbsp; Prior to becoming a consultant, she was Development Director at English National Ballet, English National Opera, and Somerset House Trust, and held senior corporate fundraising roles at V&amp;A and Tate.&nbsp; She lives in London and is also a Trustee of the Akram Khan Dance Company and Punchdrunk Enrichment.<\/p>\n<\/div><\/div><\/div>\n<\/div><\/div>\n\n\n\n<div class=\"wp-block-stackable-divider stk-block-divider stk-block stk-39f9c92 is-style-bar\" data-block-id=\"39f9c92\"><